# Plantilla para DESPLIEGUE CON DOCKER. Copiar a ".env" en esta misma
# carpeta (junto a docker-compose.yml) y completar — docker-compose lo
# lee solo, automaticamente, para las variables ${...} de
# docker-compose.yml. Ese ".env" NUNCA se commitea (ver .gitignore).
#
# (Distinto de backend/.env.example, que es para correr el backend SIN
# Docker en desarrollo local — mismo proposito, dos flujos distintos.)

# Requerido: clave de la API de Anthropic. El LLM solo redacta el
# reporte final, nunca clasifica. Sin esto el backend falla al arrancar.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar para la redaccion del reporte.
ANTHROPIC_MODEL=claude-opus-5

# Opcional: tamano del modelo Whisper (tiny/base/small/medium/large).
# "small" por defecto en el compose por la RAM limitada del servidor
# (3.7GB, sin GPU) — ver aviso de memoria en el README. Si el servidor
# no aguanta ni "small", bajar a "base".
WHISPER_MODEL_SIZE=small

# Opcional: limite de duracion de audio aceptado, en segundos.
DEMENTIA_MAX_AUDIO_SECONDS=600
