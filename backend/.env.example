# Copiar a .env (o exportar como variables de entorno reales) y completar.
# .env NUNCA debe commitearse — agregarlo a .gitignore.

# Requerido: clave de la API de Anthropic. El LLM solo redacta el reporte
# final, nunca clasifica.
ANTHROPIC_API_KEY=

# Opcional: modelo a usar para la redaccion del reporte.
ANTHROPIC_MODEL=claude-opus-5

# Opcional: tamano del modelo Whisper (tiny/base/small/medium/large).
WHISPER_MODEL_SIZE=medium
WHISPER_LANGUAGE=es
# "auto" (default) o "cpu" para forzar CPU si la VRAM esta ocupada.
WHISPER_DEVICE=auto
# Opcional: carpeta donde whisper descarga el modelo (~1.5GB para "medium").
# Por defecto usa ~/.cache/whisper. Util si esa unidad tiene poco espacio.
WHISPER_DOWNLOAD_ROOT=

# Dispositivo para Wav2Vec2 + BETO + el clasificador multimodal.
# "cpu" (default) o "cuda" si se sabe que la GPU esta libre.
TORCH_DEVICE=cpu

# Opcional: carpeta donde se descargan/cachean los modelos de Hugging
# Face (Wav2Vec2, BETO). Por defecto ~/.cache/huggingface. Util si esa
# unidad tiene poco espacio.
HF_HOME=

# Opcional: ruta del archivo SQLite. Por defecto se crea junto al backend.
DEMENTIA_DB_PATH=

# Opcional: limite de duracion de audio aceptado, en segundos.
DEMENTIA_MAX_AUDIO_SECONDS=600
